CREATE TABLE cliente (
  idcliente INTEGER(4) NOT NULL AUTO_INCREMENT,
  capacidade INTEGER(2) NOT NULL,
  idProduto INTEGER(4) NOT NULL,
  PRIMARY KEY (idcliente),
  FOREIGN KEY (idcliente) REFERENCES Produto(idProduto),
  UNIQUE KEY idcliente (idcliente)
)

CREATE TABLE Produto (
  idProduto INTEGER(4) NOT NULL AUTO_INCREMENT,
  telefone INTEGER(10) NOT NULL,
  nome CHAR(80) COLLATE NOT NULL DEFAULT '',
  PRIMARY KEY (idProduto),
  FOREIGN KEY(idcliente) REFERENCES cliente(idcliente),
  UNIQUE KEY idProduto (idProduto)
)
 CREATE TABLE vendedor(
  idvendedor INTEGER(4) NOT NULL AUTO_INCREMENT,
  telefone   INTEGER(10) NOT NULL,
  nome CHAR(80) COLLATE NOT NULL DEFAULT'',
  PRIMARY KEY (idvendedor),
  FOREIGN KEY (idProduto) REFERENCES Produto(idProduto),
  UNIQUE KEY idvendedor (idvendedor)
 )
 
